  "enforcement_notes": [
    "This file is a policy contract, not an operating-system ACL; deployment must enforce equivalent storage and account permissions.",
    "Before PREDICTIONS_FROZEN, owner, Codex, LLM/RAG, simulation and model training have zero label/outcome access.",
    "After reveal, raw labels remain curator/evaluator-only; owner and LLM/RAG may receive approved aggregate metrics only.",
    "Training may use development data only. Validation features are inference-only under an explicitly frozen protocol.",
    "Graph pretraining defaults to inductive: validation nodes/features/edges are not included. Any transductive use requires a separately declared protocol and is not authorized by this policy."
  ],
  "no_peeking_validator": {
    "manifest_filename": "validation_manifest.json",
    "input_directory": "validation_input_package",
    "sealed_labels_directory": "validation_labels_sealed",
    "required_input_files": ["input_schema.json", "cases.jsonl"],
    "allowed_input_extensions": [".json", ".jsonl", ".csv", ".tsv"],
    "prohibited_column_tokens": [
      "label",
      "labels",
      "outcome",
      "outcomes",
      "phenotype",
      "responseclass",
      "referencelabel",
      "groundtruth",
      "observedresponse",
      "targetvalue",
      "truth"
    ],
    "prohibited_filename_tokens": [
      "label",
      "outcome",
      "phenotype",
      "result",
      "groundtruth",
      "reference"
    ],
    "prohibited_value_tokens": [
      "positive",
      "negative",
      "hit",
      "nonhit",
      "responder",
      "nonresponder",
      "responsive",
      "unresponsive",
      "increased",
      "decreased",
      "suppressed",
      "enhanced",
      "effective",
      "ineffective"
    ],
    "case_id_pattern": "^EXTVAL_[0-9]{4,}$"
  }
